# ════════════════════════════════════════════════════════════════════════════
# Monomer SMILES & R-groups dictionaries (from unified library only)
# ════════════════════════════════════════════════════════════════════════════

monomers2smi_dict = {}
monomers2r_groups_dict = {}

# Standard 20 amino acids: extracted from MAP_monomers_library for correct CXSMILES
_STANDARD_AA_CXSMILES = {
    "A": ("C[C@H](N[*])C([*])=O |$;;;_R1;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "C": ("[*]N[C@@H](CS[*])C([*])=O |$_R1;;;;_R3;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "H"}),
    "D": ("[*]N[C@@H](CC([*])=O)C([*])=O |$_R1;;;;;_R3;;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "OH"}),
    "E": ("[*]N[C@@H](CCC([*])=O)C([*])=O |$_R1;;;;;;_R3;;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "OH"}),
    "F": ("[*]N[C@@H](Cc1ccccc1)C([*])=O |$_R1;;;;;;;;;;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "G": ("[*]NCC([*])=O |$_R1;;;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "H": ("[*]N[C@@H](Cc1c[nH]cn1)C([*])=O |$_R1;;;;;;;;;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "I": ("CC[C@H](C)[C@H](N[*])C([*])=O |$;;;;;;_R1;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "K": ("[*]N[C@@H](CCCCN[*])C([*])=O |$_R1;;;;;;;;_R3;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "H"}),
    "L": ("CC(C)C[C@H](N[*])C([*])=O |$;;;;;;_R1;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "M": ("CSCC[C@H](N[*])C([*])=O |$;;;;;;_R1;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "N": ("NC(=O)C[C@H](N[*])C([*])=O |$;;;;;;_R1;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "P": ("[*]N1CCC[C@H]1C([*])=O |$_R1;;;;;;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "Q": ("NC(=O)CC[C@H](N[*])C([*])=O |$;;;;;;;_R1;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "R": ("NC(=N)NCCC[C@H](N[*])C([*])=O |$;;;;;;;;;_R1;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "S": ("OC[C@H](N[*])C([*])=O |$;;;;_R1;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "T": ("C[C@@H](O[*])[C@H](N[*])C([*])=O |$;;;_R3;;;_R1;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "H"}),
    "V": ("CC(C)[C@H](N[*])C([*])=O |$;;;;;_R1;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "W": ("[*]N[C@@H](Cc1c[nH]c2ccccc12)C([*])=O |$_R1;;;;;;;;;;;;;;_R2;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
    "Y": ("Oc1ccc(C[C@H](N[*])C([*])=O)cc1 |$;;;;;;;;_R1;;_R2;;;$|", {"R1": "H", "R2": "OH", "R3": "-"}),
}
for _sym, (_cx, _rg) in _STANDARD_AA_CXSMILES.items():
    _smi = get_smi_from_cxsmiles(_cx)
    monomers2smi_dict[_sym] = _smi
    monomers2r_groups_dict[_sym] = dict(_rg)

for _sym, _row in _unified_by_symbol.items():
    _cx = str(_row.get("CXSMILES", "")).strip()
    if not _cx:
        continue
    try:
        _smi = get_smi_from_cxsmiles(_cx)
        monomers2smi_dict[_sym] = _smi
        monomers2r_groups_dict[_sym] = {}
        for _rg in ("R1", "R2", "R3"):
            _val = str(_row.get(_rg, "-")).strip()
            if _val and _val != "-":
                monomers2r_groups_dict[_sym][_rg] = _val
    except Exception:
        pass

print(f"  [map_utils] {len(monomers2smi_dict)} monomers loaded with CXSMILES")

# Terminal capping monomers (synthetic, not in library)
monomers2smi_dict["ac"] = "CC([*:_R2])=O"
monomers2r_groups_dict["ac"] = {"R2": "OH"}
monomers2smi_dict["nme"] = "CN[*:_R1]"
monomers2r_groups_dict["nme"] = {"R1": "H"}


def cyclize_linpep_from_map(monomer_list, cyclic_link):
    monomer_smis = [copy.deepcopy(monomers2smi_dict[monomer]) for monomer in monomer_list]
    monomer_r_groups = [copy.deepcopy(monomers2r_groups_dict[monomer]) for monomer in monomer_list]
    monomer_links = get_links_between_monomers(monomer_smis, cyclic_link)
    monomer_smis = restore_unused_rgroup(monomer_smis, monomer_r_groups, monomer_links)
    pep_smi = get_linear_peptide(monomer_smis)
    if cyclic_link:
        pep_smi = cyclize_linpep_from_smi(pep_smi, cyclic_link)
    return pep_smi


def linpep_from_map(monomer_list):
    monomer_smis = [copy.deepcopy(monomers2smi_dict[monomer]) for monomer in monomer_list]
    monomer_r_groups = [copy.deepcopy(monomers2r_groups_dict[monomer]) for monomer in monomer_list]
    monomer_links = get_links_between_monomers(monomer_smis, cyclic_link=None)
    monomer_smis = restore_unused_rgroup(monomer_smis, monomer_r_groups, monomer_links)
    pep_smi = get_linear_peptide(monomer_smis)
    return pep_smi


# ════════════════════════════════════════════════════════════════════════════
# MAP ↔ HELM conversion (auto-generated from unified library)
# ════════════════════════════════════════════════════════════════════════════

# MAP_denotion -> Symbol (longest-first for greedy matching)
map_to_helm_dict: dict = {}
for _sym in monomers2smi_dict:
    _map_d = _auto_map_denotion(_sym)
    if _map_d not in map_to_helm_dict:
        map_to_helm_dict[_map_d] = _sym

# Synthesized MAP denotions for caps
map_to_helm_dict["{nt:ACE}"] = "ac"
map_to_helm_dict["{ct:NME}"] = "nme"

# Sort longest-first for greedy tokenization
map_to_helm_dict = dict(sorted(map_to_helm_dict.items(),
                               key=lambda kv: (len(kv[0]), kv[0]), reverse=True))

# Symbol -> MAP_denotion reverse lookup
_symbol_to_map: dict = {}
for _k, _v in map_to_helm_dict.items():
    _symbol_to_map[_v] = _k


def extract_data(input_string):
    """Extract cyclization and terminal modification info from MAP string.

    Handles two cyclization formats:
      - Simple:  {cyc:2-5} (legacy, assumes position-based defaults)
      - Detailed: {cyc:2:R3-5:R3} (preserves R-group type)
    """
    cyc_pattern = r'\{cyc:\s*([N\d]+):?(R\d)?-([C\d\w]+):?(R\d)?\}'
    nterm_pattern = r'\{nt:[^}]+\}'

    match = re.search(cyc_pattern, input_string)
    if match:
        linker_info_original = match.group(0)
        result = re.sub(cyc_pattern, '', input_string).strip()

        # Rewrite to detailed R-group format internally
        start_pos = match.group(1)
        start_r = match.group(2) or ''
        end_pos = match.group(3)
        end_r = match.group(4) or ''
        if end_pos == 'C':
            linker_info = f'{{cyc:{start_pos}:R1-{end_pos}:R2}}'
        elif start_r and end_r:
            linker_info = f'{{cyc:{start_pos}:{start_r}-{end_pos}:{end_r}}}'
        else:
            # Default: position 1 → R1 backbone, others → R3 sidechain
            srg = 'R1' if (start_pos == 'N' or int(start_pos) == 1) else 'R3'
            erg = 'R3' if end_pos != 'C' else 'R2'
            linker_info = f'{{cyc:{start_pos}:{srg}-{end_pos}:{erg}}}'

        nterm_modifications = re.findall(nterm_pattern, result)
        if nterm_modifications:
            result = re.sub(nterm_pattern, '', result)
            result = ''.join(nterm_modifications) + result
        return result, linker_info
    else:
        nterm_modifications = re.findall(nterm_pattern, input_string)
        if nterm_modifications:
            result = re.sub(nterm_pattern, '', input_string)
            result = ''.join(nterm_modifications) + result
            return result, None
        else:
            return input_string, None


def monomer_list_from_linear_seq(linear_seq):
    """Tokenize MAP linear sequence into monomer symbols."""
    tokens = []
    i = 0
    while i < len(linear_seq):
        matched = False
        for key in map_to_helm_dict.keys():
            if linear_seq[i:].startswith(key):
                token = map_to_helm_dict[key]
                tokens.append(token)
                i += len(key)
                matched = True
                break
        if not matched:
            tokens.append(linear_seq[i])
            i += 1
    return tokens


def get_smi_from_map(map_str):
    """Convert MAP notation to SMILES.

    Supports cyclization formats:
      - Detailed: {cyc:2:R3-5:R3} (R-group type preserved)
      - Simple:   {cyc:2-5} or {cyc:N-C} (defaults applied by extract_data)
    """
    linear_seq, linker = extract_data(map_str)
    monomer_list = monomer_list_from_linear_seq(linear_seq)
    if linker:
        # Try detailed format: {cyc:1:R1-8:R2}
        # Try detailed format: {cyc:1:R1-8:R2} or {cyc:N:R1-C:R2}
        dt_m = re.search(r'\{cyc:\s*([N\d]+):(R\d)-([C\d]+):(R\d)\}', linker)
        if dt_m:
            start_raw = dt_m.group(1); start_rg = dt_m.group(2)
            end_raw = dt_m.group(3); end_rg = dt_m.group(4)
            start_pos = 1 if start_raw == 'N' else int(start_raw)
            end_pos = len(monomer_list) if end_raw == 'C' else int(end_raw)
            cyclic_linker = f'{start_pos}:{start_rg}-{end_pos}:{end_rg}'
        else:
            # Fallback: simple format {cyc:N-C} or {cyc:2-5}
            sm = re.search(r'\{cyc:\s*(N|\d+)-([C]|\d+)\}', linker)
            if not sm:
                return None
            start_part, end_part = sm.group(1), sm.group(2)
            cyclic_linker = ''
            if start_part == '1' or start_part == 'N':
                cyclic_linker += '1:R1-'
            else:
                cyclic_linker += f'{int(start_part)}:R3-'
            if end_part == 'C' or end_part == str(len(monomer_list)):
                cyclic_linker += f'{len(monomer_list)}:R2'
            else:
                cyclic_linker += f'{int(end_part)}:R3'
        try:
            smi = cyclize_linpep_from_map(monomer_list, cyclic_linker)
            return smi
        except Exception:
            return None
    else:
        try:
            smi = linpep_from_map(monomer_list)
            return smi
        except Exception:
            return None


def helm_to_map(helm):
    """Convert HELM string to MAP notation.

    Preserves R-group type info from HELM connections:
      1:R1-8:R2 → MAP: {cyc:1:R1-8:R2}
      2:R3-5:R3 → MAP: {cyc:2:R3-5:R3}
    """
    try:
        start = helm.index('{') + 1
        end = helm.index('}')
        helm_sequence = helm[start:end]
        elements = [elem.strip('[]') for elem in helm_sequence.split('.')]
        num_elements = len(elements)
        map_format = ''
        for element in elements:
            if element == 'ac':
                map_format += '{nt:ACE}'
            elif element == 'nme':
                map_format += '{ct:NME}'
            elif element in _symbol_to_map:
                map_format += _symbol_to_map[element]
            else:
                map_format += _auto_map_denotion(element)
        dollar_split = helm.split('$')
        if len(dollar_split) > 2:
            last_part = dollar_split[1]
            if len(last_part) > 0:
                last_element = last_part.split(',')[-1]
                # Parse HELM connection: "1:R1-8:R2" → start_pos=1, start_rgroup=R1, end_pos=8, end_rgroup=R2
                start_full = last_element.split('-')[0]
                end_full = last_element.split('-')[1]
                start_pos = start_full.split(':')[0]
                start_rgroup = start_full.split(':')[1]
                end_pos = end_full.split(':')[0]
                end_rgroup = end_full.split(':')[1]

                cyc_string = f'{start_pos}:{start_rgroup}-{end_pos}:{end_rgroup}'
                if int(start_pos) == 1 and int(end_pos) == num_elements and start_rgroup == 'R1' and end_rgroup == 'R2':
                    cyc_string = 'N-C'
                final_output = f'{map_format}'
                nterm_pattern = r'\{nt:[^}]+\}'
                cterm_pattern = r'\{ct:[^}]+\}'
                nterm_modifications = re.findall(nterm_pattern, final_output)
                final_output = re.sub(nterm_pattern, '', final_output)
                cterm_modifications = re.findall(cterm_pattern, final_output)
                final_output = re.sub(cterm_pattern, '', final_output)
                final_output += ''.join(nterm_modifications) + ''.join(cterm_modifications)
                return f'{final_output}{{cyc:{cyc_string}}}'
            else:
                final_output = f'{map_format}'
                nterm_pattern = r'\{nt:[^}]+\}'
                cterm_pattern = r'\{ct:[^}]+\}'
                nterm_modifications = re.findall(nterm_pattern, final_output)
                final_output = re.sub(nterm_pattern, '', final_output)
                cterm_modifications = re.findall(cterm_pattern, final_output)
                final_output = re.sub(cterm_pattern, '', final_output)
                final_output += ''.join(nterm_modifications) + ''.join(cterm_modifications)
                return final_output
    except Exception as e:
        return f"ERROR: {e}"
    return ''


def process_HELM_seq(helm_seq, ID):
    """MAP to HELM sequence conversion."""
    if '{' in helm_seq:
        start = helm_seq.index('{')
        end = helm_seq.index('}')
        cyc_seq = helm_seq[start:end]
        seq_len = len(helm_seq[end+1:].split('.'))
        cyc_list = cyc_seq.split('-')
        start_pos = cyc_list[0][-1]
        end_pos = cyc_list[1]

        if start_pos == 'N' and end_pos == 'C':
            return f'PEPTIDE{ID}{{{helm_seq[end+1:]}}}$PEPTIDE{ID},PEPTIDE{ID},1:R1-{seq_len}:R2$$$'
        elif start_pos != '1' and end_pos == str(seq_len):
            return f'PEPTIDE{ID}{{{helm_seq[end+1:]}}}$PEPTIDE{ID},PEPTIDE{ID},{start_pos}:R3-{seq_len}:R2$$$'
        elif start_pos == '1' and end_pos != str(seq_len):
            return f'PEPTIDE{ID}{{{helm_seq[end+1:]}}}$PEPTIDE{ID},PEPTIDE{ID},1:R1-{end_pos}:R3$$$'
        else:
            return f'PEPTIDE{ID}{{{helm_seq[end+1:]}}}$PEPTIDE{ID},PEPTIDE{ID},{start_pos}:R3-{end_pos}:R3$$$'
    else:
        return f'PEPTIDE{ID}{{{helm_seq}}}$$$$'


def convert_map_to_helm_sequence(map_str, ID):
    """Convert MAP notation to HELM sequence."""
    nterm_pattern = r'\{nt:[^}]+\}'
    cyc_pattern = r'\{cyc:\s*([N]|\d+)-([C]|\d+)\}'
    string = ''
    nterm_modifications = re.findall(nterm_pattern, map_str)
    map_str = re.sub(nterm_pattern, '', map_str)
    cyc_string = re.search(cyc_pattern, map_str)
    map_str = re.sub(cyc_pattern, '', map_str)
    if cyc_string:
        string += ''.join(cyc_string[0]) + ''.join(nterm_modifications) + map_str
    else:
        string += ''.join(nterm_modifications) + map_str

    tokens = []
    i = 0
    while i < len(string):
        matched = False
        for key in map_to_helm_dict.keys():
            if string[i:].startswith(key):
                if string[i-4:i] == 'cyc:':
                    val = map_to_helm_dict[key]
                    token = f'[{val}]' if len(val) > 1 else f'{val}'
                    tokens.append(token)
                    i += len(key)
                    matched = True
                    break
                else:
                    val = map_to_helm_dict[key]
                    token = f'[{val}].' if len(val) > 1 else f'{val}.'
                    tokens.append(token)
                    i += len(key)
                    matched = True
                    break
        if not matched:
            tokens.append(string[i])
            i += 1
    helm_seq = ''.join(tokens).rstrip('.')
    return helm_seq
